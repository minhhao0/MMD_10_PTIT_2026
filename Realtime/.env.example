# Sao chép file này thành .env rồi chỉnh theo máy bạn:
#   copy .env.example .env

# ── Open-Meteo ─────────────────────────────────────────────────
AQI_API_URL=https://air-quality-api.open-meteo.com/v1/air-quality
TIMEZONE=Asia/Ho_Chi_Minh
MAX_CONCURRENT_REQUESTS=3

# ── Kafka (Docker) ─────────────────────────────────────────────
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_TOPIC_RAW=aqi-raw

# ── Hadoop HDFS (Docker) ───────────────────────────────────────
HDFS_HOST=localhost
HDFS_PORT=9000

# ── PostgreSQL (Docker) ────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aqi_db
POSTGRES_USER=aqi_user
POSTGRES_PASS=aqi_pass

# ── Spark (chạy local trên máy host) ───────────────────────────
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
