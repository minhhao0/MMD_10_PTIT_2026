CORE_CONF_fs_defaultFS=hdfs://namenode:9000
CORE_CONF_hadoop_http_staticuser_user=root

# Thiết lập số bản sao dữ liệu là 1 (vì chúng ta chỉ có 1 datanode)
HDFS_CONF_dfs_replication=1

# Tắt kiểm tra IP/Hostname để cho phép khai báo IP tùy chỉnh
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# Thư mục lưu trữ dữ liệu
HDFS_CONF_dfs_namenode_name_dir=file:///hadoop/dfs/name
HDFS_CONF_dfs_datanode_data_dir=file:///hadoop/dfs/data

# ── QUAN TRỌNG: Cấu hình Mạng (Xuyên thủng Docker NAT) ──
# Docker Desktop (Windows): trình duyệt truy cập DataNode qua host
# Nếu vẫn Connection refused khi mở file trên UI 9870, thay bằng IP LAN máy bạn (ipconfig)
HDFS_CONF_dfs_datanode_hostname=host.docker.internal

# Buộc DataNode lắng nghe trên tất cả các interface mạng (0.0.0.0)
HDFS_CONF_dfs_datanode_address=0.0.0.0:9866
HDFS_CONF_dfs_datanode_http_address=0.0.0.0:9864
HDFS_CONF_dfs_datanode_ipc_address=0.0.0.0:9867

# ── Bỏ qua kiểm tra quyền (Sửa lỗi Permission Denied) ──
HDFS_CONF_dfs_permissions_enabled=false